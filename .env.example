NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email delivery through Resend.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Barak Pathways <notifications@your-verified-domain.com>
# Optional comma-separated override. When omitted, active IELTS trainers and
# administrators in the CRM receive new IELTS registration notifications.
IELTS_NOTIFICATION_EMAILS=tobbykimani@barakpathways.com,jael@barakpathways.com
# Optional recipient override for general public CRM student registrations.
CRM_STUDENT_NOTIFICATION_EMAILS=tobbykimani@barakpathways.com

# Comma-separated origins allowed to call public APIs from browsers.
# Example: https://workspace.example.com,https://www.workspace.example.com
PUBLIC_API_ALLOWED_ORIGINS=*

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=barak_pathways

# Optional: allow migration into a non-empty Supabase database.
SUPABASE_ALLOW_EXISTING_DATA=false
